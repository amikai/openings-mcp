# Past the end of the board: still a successful envelope, with the board's
# real total and an empty jobs array. This is what stops a full-board read.
POST https://app.mokahr.com/api/outer/ats-apply/website/jobs/v2
Content-Type: application/json
{
  "orgId": "high-flyer",
  "siteId": "140576",
  "limit": 5,
  "offset": 1000,
  "needStat": true,
  "locale": "en-US"
}

HTTP 200
[Asserts]
jsonpath "$.necromancer" matches "^[0-9a-f]{16}$"
jsonpath "$.data" matches "^[A-Za-z0-9+/]+={0,2}$"
